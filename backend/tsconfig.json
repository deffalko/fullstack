{
  "ts-node": {
    "files": true,
    "transpileOnly": true
  },
  "compilerOptions": {
    "plugins": [{ "transform": "typescript-transform-paths" }],
    "paths": {
      // "@ideanick/webapp/*": ["../webapp/*"],
      // "@ideanick/shared/*": ["../shared/dist/*"]
      "@ideanick/webapp/*": ["../webapp/src/*"],
      "@ideanick/shared/*": ["../shared/src/*"]
    },
    "outDir": "./dist",
    "types": ["jest", "node"],
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "strict": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "inlineSources": true,
    "isolatedModules": false,
    "lib": ["ES2021"],
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2021"
  },
  "include": ["src"]
}
