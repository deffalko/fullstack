{
  "name": "@ideanick/backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development ts-node-dev --watch ./src/emails/dist,./.env --rs --exit-child ./src/index.ts",
    "test": "jest --runInBand",
    "build-emails": "node -e \"const fs=require('fs');const path='./src/emails/dist';if(fs.existsSync(path))fs.rmSync(path,{recursive:true,force:true});fs.mkdirSync(path,{recursive:true});require('child_process').execSync('npx mjml ./src/emails/[!_]*.mjml -o ./src/emails/dist',{stdio:'inherit'})\"",
    "watch-emails": "mjml -w ./src/emails/[!_]*.mjml -o ./src/emails/dist",
    "copy-emails": "copyfiles ./src/emails/dist/*.html ./dist/backend",
    "build-ts": "rimraf ./dist && tsc --build ./tsconfig.build.json",
    "build": "pnpm build-ts && pnpm build-emails && pnpm copy-emails && node src/scripts/upload-sourcemaps.mjs",
    "upload:sourcemaps": "node src/scripts/upload-sourcemaps.mjs",
    "start": "cross-env NODE_ENV=production ts-node --project tsconfig.json ./dist/index.js",
    "pmd": "prisma migrate dev",
    "pmt": "dotenv -e ./.env.test prisma migrate deploy",
    "pmp": "dotenv -e ./.env.production prisma migrate deploy",
    "pgc": "prisma generate",
    "types": "tsc --noEmit --project ./tsconfig.json",
    "lint": "eslint --cache --cache-location ./node_modules/.cache/.eslintcache --ext .ts .",
    "prettify": "prettier --loglevel warn --cache --write '{src/**/*,*}.{ts,tsx,js,json,yml,scss}' '!**/{node_modules,dist}/**/*'",
    "reset-users": "pnpm exec tsx scripts/reset-users.ts",
    "prepare": "pnpm pgc && ts-patch install -s"
  },
  "prisma": {
    "schema": "./src/prisma/schema.prisma"
  },
  "dependencies": {
    "@ideanick/shared": "workspace:*",
    "@ideanick/webapp": "workspace:*",
    "@prisma/client": "^5.2.0",
    "@trpc/server": "^10.37.1",
    "axios": "^1.5.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.5",
    "cron": "^4.4.0",
    "date-fns": "^2.30.0",
    "debug": "^4.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-glob": "^3.3.1",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "mjml": "^4.14.1",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "picocolors": "^1.1.1",
    "prisma": "^5.2.0",
    "react-router-dom": "^6.15.0",
    "rollbar": "^3.1.0",
    "serialize-error": "8.1.0",
    "superjson": "^1.13.1",
    "triple-beam": "^1.4.1",
    "trpc-playground": "^1.0.4",
    "winston": "^3.19.0",
    "yaml": "^2.9.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/cron": "^2.4.3",
    "@types/debug": "^4.1.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.198",
    "@types/node": "^20.5.0",
    "@types/passport": "^1.0.12",
    "@types/passport-jwt": "^3.0.9",
    "@types/triple-beam": "^1.3.5",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "tsconfig-paths": "^4.2.0",
    "ttypescript": "^1.5.15",
    "typescript": "^5.0.4"
  }
}
