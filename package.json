{
  "name": "ideanick",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "pnpm --filter @ideanick/shared build && pnpm --filter @ideanick/webapp build && pnpm --filter @ideanick/backend build",
    "b": "pnpm --filter @ideanick/backend",
    "w": "pnpm --filter @ideanick/webapp",
    "sh": "pnpm --filter @ideanick/shared",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "types": "concurrently 'pnpm b types' 'pnpm w types'",
    "lint": "concurrently 'pnpm b lint' 'pnpm w lint'",
    "prettify": "pnpm -r --parallel prettify",
    "dcc": "dotenv -e ./.env.docker -e ./backend/.env -e ./webapp/.env -- bash -c 'docker compose config'",
    "dcb": "dotenv -e ./.env.docker -e ./backend/.env -e ./webapp/.env -- bash -c 'docker compose build'",
    "dcu": "dotenv -e ./.env.docker -e ./backend/.env -e ./webapp/.env -- bash -c 'docker compose up'",
    "prepare": "husky install"
  },
  "dependencies": {
    "cross-env": "^10.1.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "concurrently": "^8.2.0",
    "copyfiles": "^2.4.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^8.47.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-config-standard-with-typescript": "^37.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.16.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^8.0.3",
    "jest": "^30.4.2",
    "lint-staged": "^14.0.0",
    "prettier": "^3.0.2",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "ts-patch": "^4.0.1",
    "typescript": "^5.1.6",
    "typescript-transform-paths": "^4.0.0"
  }
}
